# Destino del proxy de desarrollo (npm run dev). Por defecto: http://localhost:8000
VITE_API_PROXY_TARGET=http://localhost:8000

# URL base de la API usada por el navegador. Por defecto: /api (vía proxy).
# Defínela solo si sirves el frontend sin el proxy de Vite, p. ej.:
# VITE_API_URL=http://localhost:8000
